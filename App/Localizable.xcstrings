            "value": "一个月以内"
          }
        }
      }
    },
    "한 달의 계절과 기록을 보여줘요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a month of seasons and records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月の季節と記録を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示一个月的季节和记录。"
          }
        }
      }
    },
    "한 바퀴": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Circle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとまわり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整一轮"
          }
        }
      }
    },
    "한 주기 안에서 가장 좋은 때와 가장 안 좋은 때, 얼마나 다른가요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within one cycle, how different are your best and worst times?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1周期の中で一番調子がいい時と悪い時は、どのくらい違いますか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一个周期里，状态最好的时候和最不好的时候，差别有多大"
          }
        }
      }
    },
    "한 주기 안에서도 에너지와 컨디션은 오르내립니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even within one cycle, your energy and how you feel rise and fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つの周期の中でも、エネルギーと体調は上がり下がりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使在一个周期里，精力和状态也会起起伏伏。"
          }
        }
      }
    },
    "한 주기 중에 컨디션이 가장 좋은 때는 언제인가요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When in a cycle do you feel best?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1周期の中で体調が一番いい時期はいつですか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个周期里状态最好的时候是什么时候"
          }
        }
      }
    },
    "한 주기를 처음부터 끝까지 함께해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See one full cycle through"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつの周期を最初から最後まで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陪伴完整一个周期"
          }
        }
      }
    },
    "한 줄 기록": {
