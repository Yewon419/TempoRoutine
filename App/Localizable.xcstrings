            "state": "translated",
            "value": "日程"
          }
        }
      }
    },
    "일정 삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete plan"
          }
        },
        "ja": {
