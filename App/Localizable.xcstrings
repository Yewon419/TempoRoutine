    "내일쯤 겨울로 접어들 수 있어요. 미리 채비해도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter may begin around tomorrow. It's fine to get ready in advance."
          }
        },
        "ja": {
