          }
        }
      }
    },
    "테마 더 만들어 주세요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please make more themes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマをもっと作ってください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请多做一些主题"
          }
        }
      }
    },
    "테마 배경 영상처럼 내려받은 파일만 지워요. 기록은 그대로예요. 지금 쓰는 테마의 파일은 필요해지면 다시 받아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only downloaded files, such as theme background videos, are removed. Your records stay as they are. Files for the theme you're using are downloaded again when they're needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの背景動画など、ダウンロードしたファイルだけを削除します。記録はそのままです。使用中のテーマのファイルは、必要になったときに再びダウンロードされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除已下载的文件，例如主题背景视频。您的记录不受影响。正在使用的主题所需的文件会在需要时重新下载。"
          }
        }
      }
    },
    "테마 화면을 엽니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the themes screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ画面を開きます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开主题页面"
          }
        }
      }
    },
    "테마를 3개 모아요": {
      "extractionState": "manual",
