    "지난 %1$@번, 예측과 실제가 평균 %2$@일 차이였어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the last %1$@ times, the prediction and the actual day differed by %2$@ days on average."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近%1$@回、予測と実際の差は平均%2$@日でした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近%1$@次，预测和实际平均相差%2$@天。"
          }
        }
      }
    },
    "지난 %lld번, 예측한 날에 시작했어요.": {
      "extractionState": "manual",
