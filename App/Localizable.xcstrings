    },
    "당신 몸의\n템포에 맞게.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In tune with\nyour body's tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの体の\nテンポに合わせて。"
          }
        }
      }
    },
    "당신만의 속도를 찾아서.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your own pace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけのペースを見つけて。"
          }
        }
      }
    },
    "당신만의 패턴이 보이기 시작할 거예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own pattern will start to show."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなただけのパターンが見えはじめます。"
          }
        }
      }
    },
    "당신만이 언제든 내보내고 지울 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can export or delete them, anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも書き出したり削除したりできるのは、あなただけです。"
          }
        }
      }
    },
    "당신의 계절은 기록이 쌓이며 맞춰집니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your seasons get more accurate as your records add up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの季節は、記録が積み重なるほど合っていきます。"
          }
        }
      }
    },
    "당신의 리듬,\n조금 더 알려주실래요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rhythm,\nwould you tell us a little more?"
