          "stringUnit": {
            "state": "translated",
            "value": "打开一次 App 就会填上"
          }
        }
      }
    },
    "앱이 너무 구려요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is so lame"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがダサすぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用太逊了"
          }
        }
      }
    },
    "약속이나 생일같은 일정을 적어봐요. 텍스트에서 시간을 자동으로 읽어올수도 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down plans like appointments or birthdays. Times can be read from the text automatically, too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約束や誕生日などの予定を書いてみてください。テキストから時刻を自動で読み取ることもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下约会、生日之类的安排吧。还可以从文字里自动读取时间。"
          }
        }
      }
    },
    "어느 계절": {
      "extractionState": "manual",
      "localizations": {
