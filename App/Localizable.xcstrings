            "state": "translated",
            "value": "要重置 App 吗？"
          }
        }
      }
    },
    "앱을 한 번 열면 채워져요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It fills in once you open the app"
          }
        },
