    "은필과 종이. 계절이 빛으로 스며드는 지면이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silverpoint and paper. A page where the seasons seep in as light."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀筆と紙。季節が光となって染み込む紙面です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银笔与纸。季节化作光，渗入纸面。"
          }
        }
      }
    },
    "응답은 이 기기에만 저장돼요.": {
      "extractionState": "manual",
