          "stringUnit": {
            "state": "translated",
            "value": "开始照顾自己的时间"
          }
        }
      }
    },
    "나를 말하기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Your Words"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分を語る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
