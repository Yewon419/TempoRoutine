          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティンが、あなただけのリズムを見つけるお手伝いをします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine 会帮你找到属于自己的节奏。"
          }
        }
      }
    },
