    "씨앗은 하루 체크인을 완성하면 하나씩 모여요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You collect one seed each time you complete a day's check-in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たねは1日のチェックインを完成させるたびに、1つずつ集まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成一天的打卡，就会攒下一颗种子。"
          }
        }
      }
    },
