            "value": "削除"
          }
        }
      }
    },
    "상단의 설명은 일반적인 경향입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The description above shows general tendencies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の説明は一般的な傾向です。"
          }
        }
      }
    },
    "생리": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理"
          }
        }
      }
    },
    "생리 기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理を記録"
          }
        }
      }
    },
    "생리 주기를 네 계절로 보고,": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sees your period cycle as four seasons,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理周期を四つの季節として見て、"
          }
        }
      }
    },
    "생리를 기록하면 계획이 보이기 시작해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a period and your plans start to appear."
          }
        },
        "ja": {
          "stringUnit": {
