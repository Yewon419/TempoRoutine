    "꼭 생리 중이 아니라도 가장 힘들었던 때를 떠올려주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of the hardest time, even if it wasn't during your period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理中でなくてもかまいません。いちばんつらかったときを思い出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使不是来月经的时候也没关系，回想最难受的那段时间就好。"
          }
        }
      }
    },
    "꽤 달라요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quite different"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かなり違います"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差别挺大"
          }
        }
      }
    },
    "나를 돌보기 시작하는 시간": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time to start looking after yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
