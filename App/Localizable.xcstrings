    "계절에 맞게 계획하는 플래너예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a planner that helps you plan in tune with your season."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節に合わせて計画するプランナーです。"
          }
        }
      }
    },
    "계획을 당신에게 맞추는 방법이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
