      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape of a rhythm is different for everyone.\nIt takes about 2 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リズムのかたちは人それぞれです。\n2分ほどかかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节奏的形状因人而异。\n大约需要 2 分钟。"
          }
        }
      }
    },
    "마음껏 몰입해도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dive in as deep as you want."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いきり没頭しても大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽情投入也很好。"
          }
        }
      }
    },
