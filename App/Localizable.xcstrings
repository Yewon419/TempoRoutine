    "기록 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无记录"
          }
        }
      }
    },
    "기록, 씨앗과 구매한 테마, 설정, iCloud 동기화 기록까지 전부 지우고 처음부터 시작해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases everything — records, seeds and purchased themes, settings, and iCloud sync data — and starts over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、タネと購入したテーマ、設定、iCloud同期データまですべて消して、最初からやり直します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉所有内容：记录、种子和已购主题、设置以及 iCloud 同步数据，然后从头开始。"
          }
        }
      }
    },
    "기록된 %1$@주기 %2$@~%3$@일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cycles logged, %2$@–%3$@ days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された%1$@周期 %2$@~%3$@日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录 %1$@ 个周期 %2$@~%3$@ 天"
          }
        }
      }
    },
    "기록된 %1$@주기 모두 %2$@일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %1$@ recorded cycles were %2$@ days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された%1$@周期すべてが%2$@日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的%1$@个周期都是%2$@天"
          }
        }
      }
    },
    "기록된 시작일과 그때까지의 예측을 비교한 값": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A comparison of the start dates you logged with the predictions made up to then"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された開始日と、その時点までの予測を比べた値"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把记录的开始日与在那之前的预测作比较得出的数值"
          }
        }
      }
    },
    "기록됨": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged"
          }
        },
