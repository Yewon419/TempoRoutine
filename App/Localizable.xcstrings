    },
    "건강 앱에 남은 생리 기록을 불러오면": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you import the period records left in the Health app,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppに残っている生理の記録を読み込むと、"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入留在“健康”App 里的月经记录后，"
          }
        }
      }
    },
    "건강 앱에 쓴 기록도 삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also delete records written to the Health app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppに書き込んだ記録も削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时删除写入“健康”App 的记录"
          }
        }
      }
    },
    "건강 앱에서 생리 기록 %lld일을 가져왔어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %lld day(s) of period records from the Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppから生理の記録を%lld日分読み込みました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从“健康”App导入%lld天的月经记录。"
          }
        }
      }
    },
    "건강 앱에서 읽어올 생리 기록이 없었어요. 기록이 없거나 읽기 권한이 꺼져 있을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There were no period records to read from the Health app. There may be no records, or read access may be off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppから読み込める生理の記録がありませんでした。記録がないか、読み取り権限がオフになっている可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可以从“健康”App 读取的月经记录。可能是还没有记录，或者读取权限没有打开。"
          }
        }
      }
    },
    "건강 앱의 기록을 함께 보고, 이 앱의 기록도 저장해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See records from the Health app here, and save this app's records there too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppの記録も一緒に見て、このAppの記録も保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起查看“健康”App 的记录，也把本 App 的记录保存到那里。"
          }
        }
      }
    },
    "건강한 아침식사": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A healthy breakfast"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的な朝ごはん"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的早餐"
          }
        }
      }
    },
    "건너뛰기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        }
      }
    },
    "검색어 지우기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索語をクリア"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除搜索词"
          }
        }
      }
    },
    "겨울": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冬"
          }
        }
      }
    },
    "겨울 3일차": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter Day 3"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬 3日目"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冬 第3天"
          }
        }
      }
    },
    "겨울 무렵이에요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's around Winter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬のころです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近冬的时候"
          }
        }
      }
    },
    "겨울 예상 · 예정일 %1$@일 지남": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter expected · %1$@ days past the due date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬の予想 · 予定日から%1$@日経過"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计冬 · 已超过预定日 %1$@天"
          }
        }
      }
    },
    "겨울로 넘어가기 전": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before Winter begins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬に入る前"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入冬天之前"
          }
        }
      }
    },
    "겨울이 시작됐어요. 조금은 쉬어가도 좋아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter has begun. It's okay to slow down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬が始まりました。少し休んでも大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冬天开始了。可以稍微歇一歇。"
          }
        }
      }
    },
    "겨울이에요. 기록상 무리하지 않는 날이 많았어요. 그 감각을 믿어봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. You often took it easy around now. Trust that instinct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録では無理しない日が多めでした。その感覚を信じて。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。记录里这时常不勉强自己。相信那种感觉。"
          }
        }
      }
    },
    "겨울이에요. 기록상 이맘때는 쉼이 먼저였어요. 오늘도 그래도 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. Your records say rest came first around now. Today can be the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録ではこの頃、休むのが先でした。今日もそれでいいんです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。记录里这时候休息优先。今天也可以这样。"
          }
        }
      }
    },
    "겨울이에요. 기록상 이맘때는 에너지가 낮았어요. 조금은 쉬어가도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's Winter. Around this time your records show lower energy. It's okay to take it easy for a bit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録では、この時期はエネルギーが低めでした。少し休んでも大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天了。记录显示这个时期精力偏低。可以稍微放慢一些。"
          }
        }
      }
    },
    "겨울이에요. 기록상 이맘때도 에너지가 꽤 있었어요. 원하는 만큼 해보아도, 이번엔 쉬어가도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's Winter. Your records show you had quite a bit of energy around this time too. Do as much as you like, or rest this time around."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録では、この時期もエネルギーがけっこうありました。やりたいだけ進めても、今回は休んでも大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在是冬。记录上，这个时候你的能量也挺不错。想做多少都可以，这次歇一歇也很好。"
          }
        }
      }
    },
    "겨울이에요. 기록상 이맘때도 힘이 남아 있었어요. 다만 무리는 말아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. You've had energy to spare around now — just don't overdo it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録ではこの頃も力が残っていました。ただ無理はしないで。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。记录里这时也还有余力，只是别勉强。"
          }
        }
      }
    },
    "겨울이에요. 기록상 이맘때의 당신은 잔잔했어요. 천천히 가도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's Winter. Your records show you were calm around this time. It's fine to go slowly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。記録では、この時期のあなたは穏やかでした。ゆっくり進んでも大丈夫です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在是冬。从记录看，这个时候的你很平静。慢慢来也可以。"
          }
        }
      }
    },
    "겨울이에요. 따뜻한 것 하나면 충분한 날도 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. Some days one warm thing is enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。温かいものひとつで十分な日もあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。有些日子一件温暖的事就够了。"
          }
        }
      }
    },
    "겨울이에요. 몸이 하는 말을 먼저 들어봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. Listen to your body first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。まずは体の声を聞いてみて。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。先听听身体的声音。"
          }
        }
      }
    },
    "겨울이에요. 오늘은 나에게 너그러워도 좋아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter. Be gentle with yourself today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬です。今日は自分にやさしくていいんです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是冬天。今天可以对自己宽容一点。"
          }
        }
      }
    },
    "결제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买"
          }
        }
      }
    },
    "결제 창을 여는 중이에요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the payment sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入画面を開いています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开支付页面"
          }
        }
      }
    },
    "결제가 완료됐어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決済が完了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付已完成。"
          }
        }
      }
    },
    "결제가 이루어지지 않았어요. 잠시 뒤에 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment didn't go through. Please try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決済が行われませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付未完成。请稍后再试。"
          }
        }
      }
    },
    "결제를 끝내지 못했어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't complete the purchase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能完成购买"
          }
        }
      }
    },
    "계속": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "계절 기록 전": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before your first record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を始める前"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始记录之前"
          }
        }
      }
    },
    "계절 사이를 지나고 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're passing between seasons"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節の間を通っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正走在季节之间"
          }
        }
      }
    },
    "계절 시작 +%1$@일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season start +%1$@ days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節の始まり +%1$@日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "季节开始 +%1$@天"
          }
        }
      }
    },
    "계절 이름의 숨은 반응을 찾았어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found the season title's hidden response"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節の名前の隠れた反応を見つけました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现了季节名的隐藏反应"
          }
        }
      }
    },
    "계절과 루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seasons and routines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節とルーティン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "季节与日常"
          }
        }
      }
    },
    "계절마다 컨디션이 어땠는지, 루틴은 얼마나 했는지, 그날의 한 줄은 무엇이었는지를 나눠서 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how each season felt, how much of your routine you kept, and what you wrote that day, each in its own place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節ごとの調子、ルーティンをどれくらい続けたか、その日の一行を、それぞれ分けて見られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以分开查看每个季节的状态、routine 完成了多少、当天写下的一行是什么。"
          }
        }
      }
    },
    "계절별 루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routines by season"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節ごとのルーティン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各季节的日常"
          }
        }
      }
    },
    "계절에 맞게 계획하는 플래너예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a planner that helps you plan in tune with your season."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節に合わせて計画するプランナーです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一款配合季节来安排计划的计划表。"
          }
        }
      }
    },
    "계절을 만진 손": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touched a Season"
          }
        },
