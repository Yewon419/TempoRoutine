    "보다 편한 시작을 할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start out more comfortably."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より楽に始められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以更轻松地开始。"
          }
        }
      }
    },
    "보유중인 테마만": {
      "localizations": {
