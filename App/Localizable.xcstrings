            "state": "translated",
            "value": "国軍の日"
          }
        }
      }
    },
    "권한 설정 열기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open permission settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限設定を開く"
          }
        }
      }
    },
    "그것 때문에 사람들과 지내기 불편했던 적 있나요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has it made being around people uncomfortable?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのせいで人と過ごすのがつらかったことはありますか"
          }
        }
      }
    },
    "그것 때문에 할 일을 못 하거나 미룬 적 있나요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has it kept you from doing things, or made you put them off?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのせいでやるべきことができなかったり、先延ばしにしたことはありますか"
          }
        }
      }
    },
    "그나마 힘들었던 때를 떠올려서, 평소와 비교해서 답해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think back to when it was hardest, and answer compared to how you usually feel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較的つらかった時期を思い出して、普段と比べてお答えください。"
          }
        }
      }
    },
    "그날 한 줄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line for the day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日の一行"
          }
        }
      }
    },
    "그동안은": {
      "extractionState": "manual",
      "localizations": {
        "en": {
