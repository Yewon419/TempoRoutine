    "답이 담겼어요. 고마워요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers are saved. Thank you."
          }
        },
        "ja": {
          "stringUnit": {
