          }
        }
      }
    },
    "기존 캘린더의 약속과 생일을 가져올까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import events and birthdays from your existing calendar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のカレンダーの予定と誕生日を読み込みますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要导入现有日历里的约会和生日吗？"
          }
        }
      }
    },
    "기준일": {
