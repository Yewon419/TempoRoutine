            "value": "・予測"
          }
        }
      }
    },
    "「%@」으로 시작하기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with \"%@\""
          }
        },
        "ja": {
          "stringUnit": {
