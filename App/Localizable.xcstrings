      }
    },
    "나중에 설정에서 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで設定から変更できます。"
          }
        }
      }
    },
    "날씨": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気"
          }
        }
      }
    },
    "날씨 연동 전 임시 스위치예요. 「시계 따름」이면 시간대가 기기 시계를 따라요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary switch until weather is connected. With \"Follow clock,\" the time of day follows your device clock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気連携までの一時的なスイッチです。「時計に合わせる」にすると、時間帯が端末の時計に従います。"
          }
        }
      }
    },
    "날씨 테마는 지금 계신 곳의 하늘을 그려요. 설정 > 위치에서 접근을 허용하면 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather theme draws the sky where you are right now. You can use it once you allow access in Settings > Location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気テーマは、今いる場所の空を描きます。設定 > 位置情報でアクセスを許可すると使えます。"
          }
        }
      }
    },
    "날짜 선택": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を選択"
          }
        }
      }
    },
    "날짜 아래 선으로 계절을 알 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line under each date tells you the season"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付の下の線で季節がわかります"
          }
        }
      }
    },
    "날짜를 탭하면 빠르게 일정을 추가할 수 있어요. 길게 누르고 드래그해 며칠에 걸친 일정도 추가할 수 있어요. \n길게 누르면 하루 상세 탭으로 넘어갑니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a date for a quick add. Press and drag to add an event that spans several days. \nPress and hold to go to the Day detail tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付をタップするとクイック追加ができます。長押ししてドラッグすると、数日にまたがる予定も追加できます。 \n長押しすると一日の詳細タブに移動します。"
          }
        }
      }
    },
    "낮": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
