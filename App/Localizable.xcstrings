    "지난 생리에서 다음 생리까지의 간격을 알려주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know the gap from one period to the next."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の生理から次の生理までの間隔を教えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们上次月经到下次月经之间的间隔。"
          }
        }
      }
    },
    "지난 주기 돌아보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Cycle in Review"
          }
