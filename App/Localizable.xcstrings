            "value": "チェック"
          }
        }
      }
    },
    "체크 기록이 함께 지워져요. 되돌릴 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your check records will be deleted along with it. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックの記録も一緒に削除されます。元に戻せません。"
          }
        }
      }
    },
    "체크리스트": {
