{
  "sourceLanguage": "ko",
  "strings": {
    "%1$lld/%2$lld일차": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day %1$lld of %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld日目"
          }
        }
      }
    },
    "%lld일차": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日目"
          }
        }
      }
    },
    "가을": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autumn"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秋"
          }
        }
      }
    },
    "가을이에요. 스스로를 돌아보는 시간을 가져봐요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's autumn. Take some time to look back on yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秋です。自分を振り返る時間を持ってみましょう。"
          }
        }
      }
    },
    "겨울": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬"
          }
        }
      }
    },
    "계절 기록 전": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before your first record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を始める前"
          }
        }
      }
    },
    "괜찮아요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No thanks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大丈夫です"
          }
        }
      }
    },
    "나의 템포": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイテンポ"
          }
        }
      }
    },
    "눈": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪"
          }
        }
      }
    },
    "마음껏 몰입해도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dive in as deep as you want."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いきり没頭しても大丈夫です。"
          }
        }
      }
    },
    "목표일까지 %lld일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days to the target date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標日まで %lld 日"
          }
        }
      }
    },
    "목표일에서 %lld일 지남": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days past the target date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標日から %lld 日経過"
          }
        }
      }
    },
    "미완료": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了"
          }
        }
      }
    },
    "봄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "春"
          }
        }
      }
    },
    "봄이에요. 가볍게 시작해보기 좋은 때예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's spring. A good time to start something light."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "春です。軽く始めるのにいい時期です。"
          }
        }
      }
    },
    "비": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雨"
          }
        }
      }
    },
    "삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "생리 기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理を記録"
          }
        }
      }
    },
    "생리를 기록하면 계획이 보이기 시작해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a period and your plans start to appear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理を記録すると、計画が見えはじめます。"
          }
        }
      }
    },
    "설정": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "설정의 알림에서 언제든 바꿀 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this anytime in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の通知でいつでも変更できます。"
          }
        }
      }
    },
    "시동 거는 주기예요. 가볍게 시작해도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your engine is warming up. Starting small is enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンがかかる時期です。軽く始めても大丈夫です。"
          }
        }
      }
    },
    "아직 없어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません"
          }
        }
      }
    },
    "알림 받기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取る"
          }
        }
      }
    },
    "여름": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夏"
          }
        }
      }
    },
    "여름이에요. 하고 싶은 만큼 빛나도 좋아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's summer. Shine as much as you'd like."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夏です。好きなだけ輝いていい時期です。"
          }
        }
      }
    },
    "예상": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予想"
          }
        }
      }
    },
    "예정일에서 %lld일이 지났어요. 리듬은 늘 조금씩 다르니, 생리가 시작되면 캘린더에서 기록해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been %lld days past the expected date. Rhythms shift a little every cycle — when your period starts, log it in the calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定日から %lld 日が過ぎました。リズムはいつも少しずつ変わります。生理が始まったらカレンダーに記録してください。"
          }
        }
      }
    },
    "예측 기반": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定"
          }
        }
      }
    },
    "오늘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        }
      }
    },
    "오늘은 천천히 이어가볼까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we take today slowly?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はゆっくり続けてみませんか？"
          }
        }
      }
    },
    "완료": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "이번 주는 겨울이에요. 조금은 쉬어가도 괜찮아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's winter this week. It's okay to take it slow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週は冬です。少し休んでも大丈夫です。"
          }
        }
      }
    },
    "일정 있는 날 아침 브리핑과\n생리 예정일을 알림으로 챙겨드릴 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can send a morning briefing on days with plans,\nand a heads-up before your period is due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定のある日の朝のブリーフィングと\n生理の予定日をお知らせできます。"
          }
        }
      }
    },
    "조금 더 해볼 수 있나요? 무리하지는 말아요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel like doing a bit more? Just don't push too hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少しできそうですか？ 無理はしないでくださいね。"
          }
        }
      }
    },
    "종일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日"
          }
        }
      }
    },
    "지금 %1$lld도, 최고 %2$lld도, 최저 %3$lld도, %4$@ 올 확률 %5$lld퍼센트": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now %1$lld degrees, high %2$lld, low %3$lld, %4$@ chance %5$lld percent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今 %1$lld度、最高 %2$lld度、最低 %3$lld度、%4$@ の確率 %5$lld パーセント"
          }
        }
      }
    },
    "지금 %lld°": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now %lld°"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今 %lld°"
          }
        }
      }
    },
    "첫 생리 시작일을 기록하면, 당신의 계절이 시작돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you log the first day of your period, your seasons begin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の生理開始日を記録すると、あなたの季節が始まります。"
          }
        }
      }
    },
    "첫 생리일 기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log first period day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の生理日を記録"
          }
        }
      }
    },
    "체크": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェック"
          }
        }
      }
    },
    "최고 %1$lld° 최저 %2$lld°": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "H %1$lld° L %2$lld°"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高 %1$lld° 最低 %2$lld°"
          }
        }
      }
    },
    "캘린더": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダー"
          }
        }
      }
    },
    "탭하면 수정, 길게 누르면 삭제할 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to edit, press and hold to delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで編集、長押しで削除できます"
          }
        }
      }
    },
    "테마 화면을 엽니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the themes screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ画面を開きます"
          }
        }
      }
    },
    "템포루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティン"
          }
        }
      }
    }
  },
  "version": "1.0"
}
