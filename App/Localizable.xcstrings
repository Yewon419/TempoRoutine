        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用“健康”App"
          }
        }
      }
    },
    "건강 앱 설정에 따라 동기화될 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may sync depending on your settings in the Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppの設定によって同期されることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据“健康”App 的设置，可能会同步。"
          }
        }
      }
    },
