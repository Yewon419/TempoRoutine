            "value": "最近の周期 %@日"
          }
        }
      }
    },
    "캘린더": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダー"
          }
        }
      }
    },
    "캘린더 가져오기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import calendar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを読み込む"
          }
        }
      }
    },
    "캘린더 접근이 꺼져 있어요. 설정 앱의 개인정보 보호에서 캘린더 접근을 허용하면 다시 가져올 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is turned off. Allow calendar access under Privacy in the Settings app, and you can import again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがオフになっています。設定Appのプライバシーでカレンダーへのアクセスを許可すると、もう一度読み込めます。"
          }
        }
      }
    },
    "컨디션": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How you feel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体調"
          }
        }
      }
    },
    "타이머": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー"
          }
        }
      }
    },
    "탭하면 수정, 길게 누르면 삭제할 수 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to edit, press and hold to delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで編集、長押しで削除できます"
          }
        }
      }
    },
    "탭해서 담아볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can tap to add one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして追加できます。"
          }
        }
      }
    },
    "테마": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        }
      }
    },
    "테마 화면을 엽니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the themes screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ画面を開きます"
          }
        }
      }
    },
    "템포루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティン"
          }
        }
      }
    },
    "템포루틴 · 당신 몸의 템포에 맞게": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine · In tempo with your body"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティン・あなたの体のテンポに合わせて"
          }
        }
      }
    },
    "템포루틴은 당신이 기록해 놓은 과거를 기반으로\n당신만의 템포를 보여주는 앱입니다.\n의학적 진단이나 조언은 포함되어 있지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine is an app that, based on the past you've recorded,\nshows you a tempo that is yours alone.\nIt doesn't include medical diagnosis or advice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティンは、あなたが記録してきた過去をもとに\nあなただけのテンポを見せるAppです。\n医学的な診断や助言は含まれていません。"
          }
        }
      }
    },
    "템포루틴이 당신만의 리듬을 찾게 도와줄게요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine will help you find your own rhythm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティンが、あなただけのリズムを見つけるお手伝いをします。"
          }
        }
      }
    },
    "퍼센트": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーセント"
          }
        }
      }
    },
    "플래너와 체크인은 당신의 iCloud로 기기 간에 이어지고,": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The planner and check-ins carry over between devices through your iCloud,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランナーとチェックインは、あなたのiCloudで端末間につながり、"
          }
        }
      }
    },
    "하늘 (확인용)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sky (test)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカイ（確認用）"
          }
        }
      }
    },
    "하루를 간단히 남겨봐요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave a short note about your day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日を簡単に書き残してみませんか"
          }
        }
      }
    },
    "한 달 안의 사계절": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four seasons in a month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと月の中の四季"
          }
        }
      }
    },
    "한 주기 안에서도 에너지와 컨디션은 오르내립니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even within one cycle, your energy and how you feel rise and fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つの周期の中でも、エネルギーと体調は上がり下がりします。"
          }
        }
      }
    },
    "한 줄 기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-line record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一行記録"
          }
        }
      }
    },
    "혼자 만들고 있어요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm making this on my own"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとりでつくっています"
          }
        }
      }
    }
  },
  "version": "1.0"
