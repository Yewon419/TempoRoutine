            "value": "金"
          }
        }
      }
    },
    "기간 반복": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat over a range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間で繰り返し"
          }
        }
      }
    },
    "기기 간 동기화": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync across devices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス間の同期"
          }
        }
      }
    },
    "기기를 바꾸시나요? 내보내기 파일을 새 기기로 보내고 「백업 가져오기」로 열면 기록이 이어져요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching devices? Send the export file to your new device and open it with “Import backup” to carry your records over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を変えますか？書き出したファイルを新しい端末に送り、「バックアップを読み込む」で開くと記録が引き継がれます。"
          }
        }
      }
    },
    "기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録"
          }
        }
      }
    },
    "기록 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録なし"
          }
        }
      }
    },
    "기록된 시작일과 그때까지의 예측을 비교한 값": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A comparison of the start dates you logged with the predictions made up to then"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された開始日と、その時点までの予測を比べた値"
          }
        }
      }
    },
    "기록됨": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済み"
          }
        }
      }
    },
    "기록만 삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete records only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のみ削除"
          }
        }
      }
    },
    "기록상 %@에 계획한 걸 가장 많이 수행했어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records show you got the most done in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録では、%@に予定を一番多くこなしています。"
          }
        }
      }
    },
    "기록상 생리 시작 %@일 전부터 컨디션이 낮게 기록됐어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your records, how you feel starts dipping %@ days before your period begins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録では、生理が始まる%@日前から体調が低めに記録されています。"
          }
        }
      }
    },
    "기록은 이 기기에 저장됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records stay on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末に保存されます。"
          }
        }
      }
    },
    "기록은 이 기기에만 저장됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records are saved only on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末にのみ保存されます。"
          }
        }
      }
    },
    "기록은 이 기기와 Apple 건강 앱에 저장돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records are saved on this device and in the Apple Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末とAppleのヘルスケアAppに保存されます。"
          }
        }
      }
    },
    "기록을 저장하지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record couldn't be saved. Please try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を保存できませんでした。少し経ってからもう一度お試しください。"
          }
        }
      }
    },
    "기록의 저장은 \n오로지 이곳에만": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records are kept \nhere and nowhere else"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録の保存は \nここだけに"
          }
        }
      }
    },
    "기록이 12회쯤 쌓이면 계절별 패턴을 여기 담아둘게요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have about 12 records, we'll keep your patterns by season here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が12回ほどたまると、季節ごとのパターンをここにまとめます。"
          }
        }
      }
    },
    "기록이 부족한 시기 알려주기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when records are sparse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が少ない時期を知らせる"
          }
        }
      }
    },
    "기록하면 계절이 채워져요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The season fills in as you log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録すると季節が満ちていきます"
          }
        }
      }
    },
    "기록할 것": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to log"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録すること"
          }
        }
      }
    },
    "기본": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシック"
          }
        }
      }
    },
    "기본 지면에 다홍 한 점. 계절은 밝기로 갈려요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One scarlet dot on the basic ground. Seasons are told apart by brightness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシックな地に朱色をひと点。季節は明るさで分かれます。"
          }
        }
      }
    },
    "기본 테마.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Basic theme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシックのテーマです。"
          }
        }
      }
    },
    "기본과 은필 중 당신의 테마를 골라 가지세요. 고른 테마는 계속 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your theme from Basic and Silverpoint. The theme you pick is yours to keep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシックと銀筆から、あなたのテーマを選んでください。選んだテーマはずっと使えます。"
          }
        }
      }
    },
    "기분": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分"
          }
        }
      }
    },
    "기분은": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分は"
          }
        }
      }
    },
    "기존 캘린더의 약속과 생일을 가져올까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import events and birthdays from your existing calendar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のカレンダーの予定と誕生日を読み込みますか？"
          }
        }
      }
    },
    "기준일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準日"
          }
        }
      }
    },
    "기타": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        },
