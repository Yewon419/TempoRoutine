          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次月经是……"
          }
        }
      }
    },
    "마지막 응답 %1$@건이 이 기기에 저장돼 있어요. 다시 답하면 새 응답으로 갱신됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last %1$@ answers are saved on this device. Answering again updates them with your new answers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の回答%1$@件がこの端末に保存されています。もう一度答えると、新しい回答に更新されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的%1$@条回答保存在这台设备上。再答一次会更新为新的回答。"
          }
        }
      }
    },
    "마지막으로": {
