          "stringUnit": {
            "state": "translated",
            "value": "你自己的规律会慢慢显现出来。"
          }
        }
      }
    },
    "당신만이 언제든 내보내고 지울 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can export or delete them, anytime."
          }
        },
        "ja": {
