            "value": "ヘルスケアApp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“健康”App"
          }
        }
      }
    },
    "건강 앱 권한을 허용하지 않으면 연동할 수 없습니다. 직접 기록으로 이어갈게요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without permission for the Health app, it can't be connected. We'll continue with records you enter yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppの権限を許可しないと連携できません。手入力の記録で続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许“健康”App的权限就无法连接。会继续使用你自己输入的记录。"
          }
        }
      }
    },
    "건강 앱 권한을 허용하지 않으면 연동할 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without permission for the Health app, it can't be connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppの権限を許可しないと連携できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不允许“健康”App 权限，就无法连接。"
          }
        }
      }
    },
    "건강 앱 사용 불가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Health app is unavailable"
          }
        },
        "ja": {
