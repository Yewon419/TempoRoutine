    "템포루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティン"
          }
        }
      }
    },
    "템포루틴 · 당신 몸의 템포에 맞게": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine · In tempo with your body"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティン・あなたの体のテンポに合わせて"
          }
        }
      }
    },
    "템포루틴은 당신이 기록해 놓은 과거를 기반으로\n당신만의 템포를 보여주는 앱입니다.\n의학적 진단이나 조언은 포함되어 있지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine is an app that, based on the past you've recorded,\nshows you a tempo that is yours alone.\nIt doesn't include medical diagnosis or advice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティンは、あなたが記録してきた過去をもとに\nあなただけのテンポを見せるAppです。\n医学的な診断や助言は含まれていません。"
          }
        }
      }
    },
    "템포루틴이 당신만의 리듬을 찾게 도와줄게요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TempoRoutine will help you find your own rhythm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンポルーティンが、あなただけのリズムを見つけるお手伝いをします。"
          }
        }
      }
    },
