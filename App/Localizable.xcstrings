    "나중에 설정에서 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
