          }
        }
      }
    },
    "기록만 삭제": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete records only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のみ削除"
          }
