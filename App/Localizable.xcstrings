            "value": "「%@」ではじめる"
          }
        }
      }
    },
    "가을": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autumn"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秋"
          }
        }
      }
    },
    "가을이에요. 스스로를 돌아보는 시간을 가져봐요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's autumn. Take some time to look back on yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秋です。自分を振り返る時間を持ってみましょう。"
          }
        }
      }
    },
    "가져올게요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む"
          }
        }
      }
    },
    "개발자": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者"
          }
        }
      }
    },
    "건강 앱": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアApp"
          }
        }
      }
    },
    "건강 앱 설정에 따라 동기화될 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may sync depending on your settings in the Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppの設定によって同期されることがあります。"
          }
        }
      }
    },
    "건강 앱과 연동": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the Health app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppと連携"
          }
        }
      }
    },
    "건강 앱에 남은 생리 기록을 불러오면": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you import the period records left in the Health app,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアAppに残っている生理の記録を読み込むと、"
          }
        }
      }
    },
    "겨울": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬"
          }
        }
      }
    },
    "겨울로 넘어가기 전": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before Winter begins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冬に入る前"
          }
        }
      }
    },
    "계절 기록 전": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before your first record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を始める前"
          }
        }
      }
    },
    "계절과 루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seasons and routines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節とルーティン"
          }
        }
      }
    },
    "계절별 루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routines by season"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節ごとのルーティン"
          }
        }
      }
    },
    "계절에 맞게 계획하는 플래너예요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a planner that helps you plan in tune with your season."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "季節に合わせて計画するプランナーです。"
          }
        }
      }
    },
    "계획을 당신에게 맞추는 방법이에요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a way to fit your plans to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画をあなたに合わせる方法です。"
          }
        }
      }
    },
    "괜찮아요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No thanks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大丈夫です"
          }
        }
      }
    },
    "그동안은": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until then,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでは"
          }
        }
      }
    },
    "기기를 바꾸시나요? 내보내기 파일을 새 기기로 보내고 「백업 가져오기」로 열면 기록이 이어져요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching devices? Send the export file to your new device and open it with “Import backup” to carry your records over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末を変えますか？書き出したファイルを新しい端末に送り、「バックアップを読み込む」で開くと記録が引き継がれます。"
          }
        }
      }
    },
    "기록": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録"
          }
        }
      }
    },
    "기록된 시작일과 그때까지의 예측을 비교한 값": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A comparison of the start dates you logged with the predictions made up to then"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された開始日と、その時点までの予測を比べた値"
          }
        }
      }
    },
    "기록상 %@에 계획한 걸 가장 많이 수행했어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records show you got the most done in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録では、%@に予定を一番多くこなしています。"
          }
        }
      }
    },
    "기록상 생리 시작 %@일 전부터 컨디션이 낮게 기록됐어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your records, how you feel starts dipping %@ days before your period begins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録では、生理が始まる%@日前から体調が低めに記録されています。"
          }
        }
      }
    },
    "기록은 이 기기와 Apple 건강 앱에 저장돼요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records are saved on this device and in the Apple Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末とAppleのヘルスケアAppに保存されます。"
          }
        }
      }
    },
    "기본": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシック"
          }
        }
      }
    },
    "기본과 은필 중 당신의 테마를 골라 가지세요. 고른 테마는 계속 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick your theme from Basic and Silverpoint. The theme you pick is yours to keep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシックと銀筆から、あなたのテーマを選んでください。選んだテーマはずっと使えます。"
          }
        }
      }
    },
    "기존 캘린더의 약속과 생일을 가져올까요?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import events and birthdays from your existing calendar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のカレンダーの予定と誕生日を読み込みますか？"
          }
        }
      }
    },
    "기타": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        }
      }
    },
    "나의 루틴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My routines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイルーティン"
          }
        }
      }
    },
    "나의 템포": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイテンポ"
          }
        }
      }
    },
    "나중에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        }
      }
    },
    "나중에 설정에서 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで設定から変更できます。"
          }
        }
      }
    },
    "날씨 연동 전 임시 스위치예요. 「시계 따름」이면 시간대가 기기 시계를 따라요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary switch until weather is connected. With \"Follow clock,\" the time of day follows your device clock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気連携までの一時的なスイッチです。「時計に合わせる」にすると、時間帯が端末の時計に従います。"
          }
        }
      }
    },
    "날씨 테마는 지금 계신 곳의 하늘을 그려요. 설정 > 위치에서 접근을 허용하면 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather theme draws the sky where you are right now. You can use it once you allow access in Settings > Location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気テーマは、今いる場所の空を描きます。設定 > 位置情報でアクセスを許可すると使えます。"
          }
        }
      }
    },
