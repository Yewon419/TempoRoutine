      }
    },
    "하루 체크인을 완성하면 씨앗이 하나씩 모여요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a day's check-in and you gather one seed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日のチェックインを完成させると、たねが一つずつ集まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一天的打卡，就会攒到一颗种子。"
          }
        }
      }
    },
    "하루 체크인을 완성할 때마다 씨앗이 하나씩 모여요. 탭하면 테마 화면이 열리고, 모은 씨앗으로 새 테마를 구매할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time you complete a day's check-in, one seed is collected. Tap to open the theme screen, where you can buy a new theme with the seeds you've collected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日のチェックインを完成させるたびに、たねが一つずつ集まります。タップするとテーマ画面が開き、集めたたねで新しいテーマを購入できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成一天的打卡，就会攒下一颗种子。轻点可以打开主题页面，用攒下的种子购买新主题。"
          }
        }
      }
    },
    "하루를 간단히 남겨봐요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave a short note about your day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日を簡単に書き残してみませんか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简单记下这一天吧"
          }
        }
      }
    },
    "하루의 구성 %1$@ / 3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How a day is made up %1$@ / 3"
